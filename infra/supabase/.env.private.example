# Merge these private-development values into the official docker/.env after
# running the upstream key generators. This file is not a replacement for the
# official .env and intentionally contains no secret values.

SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1

SITE_URL=http://localhost:5174
ADDITIONAL_REDIRECT_URLS=http://localhost:5174/**

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

FUNCTIONS_VERIFY_JWT=false

KONG_HTTP_PORT=8000
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

QINIU_API_ENDPOINT=https://api.qnaigc.com/v1
QINIU_MODEL=qwen/qwen3.7-plus
# Add QINIU_API_KEY directly to docker/.env. Use a low-quota development key.

# Public App API rollout values are applied by
# scripts/supabase/configure-public-url.sh after DNS and Caddy preflight:
#
# SUPABASE_PUBLIC_URL=https://api.iamchatgpt.top
# API_EXTERNAL_URL=https://api.iamchatgpt.top/auth/v1
# SITE_URL=fragmentarticle://auth/callback
# ADDITIONAL_REDIRECT_URLS=fragmentarticle://auth/callback,http://localhost:5174/**,http://localhost:5183/**,https://iamchatgpt.top/**,https://www.iamchatgpt.top/**
#
# The rollout script intentionally keeps DISABLE_SIGNUP=false until the
# owner account is confirmed. Set it to true immediately after bootstrap.
