<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fragmentarticle.supabase-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/scripts/supabase/backup-private.sh</string>
    <string>root@TAILSCALE_HOSTNAME</string>
    <string>age1REPLACE_WITH_PUBLIC_RECIPIENT</string>
    <string>/Users/REPLACE_USER/Backups/fragment-article/supabase</string>
    <string>/opt/fragment-article/supabase</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE_USER/Library/Logs/fragmentarticle-supabase-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_USER/Library/Logs/fragmentarticle-supabase-backup.error.log</string>
</dict>
</plist>
