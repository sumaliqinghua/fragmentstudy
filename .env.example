# 复制为 .env.local 并按需填写（.env.local 不会提交到 Git）
#
# npm run dev        → 仅启动前端
# npm run dev:menu   → 方向键选择本地 Supabase / 远程 / 访客模式
# npm run launch     → 同上（简短别名）

# --- 远程 / 自托管 Supabase（dev:app 或生产构建时使用）---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# --- 本地 AI 代理（npm run dev 时由 Vite 转发，Key 不进入浏览器）---
QINIU_API_KEY=your-api-key
QINIU_API_ENDPOINT=https://api.qnaigc.com/v1
QINIU_MODEL=qwen/qwen3.7-plus

# --- 可选 ---
# VITE_PLATFORM_AI_ENABLED=true
# VITE_AUTH_EMAIL_DELIVERY_ENABLED=false
# VITE_FAL_KEY=...
