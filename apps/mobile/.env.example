# Copy to .env (or .env.local) — never commit secrets.

# Same Supabase project as the web app (use public URL + anon key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Set true when openai-proxy edge function + platform AI are available
EXPO_PUBLIC_PLATFORM_AI_ENABLED=false

# Password reset email (usually false in early dev)
EXPO_PUBLIC_AUTH_EMAIL_DELIVERY_ENABLED=false
